{
  "manifest_version": 3,
  "name": "Header Master",
  "version": "0.1.0",
  "description": "全局修改 HTTP 请求头（覆盖 / 删除）",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Header Master"
  }
}
